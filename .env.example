# Server-only, read by api/subscribe.js. Never prefix with VITE_: that would ship it to the browser.
MAILERLITE_API_TOKEN=
# Optional; defaults to the "TNES. newsletter" group.
MAILERLITE_GROUP_ID=
# Server-only, read by api/contact.js. Sends inquiries from site@tnes.studio once the domain is verified in Resend.
RESEND_API_KEY=
# Optional overrides: CONTACT_TO (default vlevy@tnes.studio), RESEND_FROM.
VITE_CLARITY_PROJECT_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/shop", "destination": "/works", "permanent": true },
    { "source": "/shop/:path*", "destination": "/works/:path*", "permanent": true },
    { "source": "/prototype-3d/:method(1|2|3)", "has": [{ "type": "host", "value": "www.tnes.studio" }], "destination": "/prototype-3d", "permanent": false },
    { "source": "/prototype-3d/:method(1|2|3)", "has": [{ "type": "host", "value": "tnes.studio" }], "destination": "/prototype-3d", "permanent": false }
  ],
  "rewrites": [
    { "source": "/works", "destination": "/works/index.html" },
    { "source": "/works/catalogs/:slug", "destination": "/works/catalogs/:slug/index.html" },
    { "source": "/works/:id", "destination": "/works/:id/index.html" },
    { "source": "/moments", "destination": "/moments/index.html" },
    { "source": "/wall", "destination": "/wall/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/cart", "destination": "/cart/index.html" },
    { "source": "/favorites", "destination": "/favorites/index.html" },
    { "source": "/special-prices", "destination": "/special-prices/index.html" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/home-black", "destination": "/home-black/index.html" },
    { "source": "/prototype-3d", "destination": "/prototype-3d/index.html" },
    { "source": "/prototype-3d/:method(1|2|3)", "destination": "/prototype-3d/lab/index.html" },
    { "source": "/true-size", "destination": "/prototype-3d/lab/index.html" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}

# Copy to .env for local work. Never commit .env.
# In production these live in Vercel ▸ Project ▸ Settings ▸ Environment Variables.

# ---- Server-only (Vercel functions in api/) — never prefix with VITE_, that would ship them to the browser

# Newsletter signups (api/subscribe.js). Required.
MAILERLITE_API_TOKEN=
# Optional; defaults to the "TNES. newsletter" group.
MAILERLITE_GROUP_ID=

# Contact and catalog inquiries (api/contact.js). Required. Sends from site@tnes.studio
# once tnes.studio is verified in Resend.
RESEND_API_KEY=
# Optional: CONTACT_TO (default vlevy@tnes.studio), RESEND_FROM (default "TNES. website <site@tnes.studio>").

# ---- Public, baked into the bundle — already set in .env.production, so Vercel does not need them

VITE_CLARITY_PROJECT_ID=
VITE_POSTHOG_KEY=
# Optional; defaults to the US region.
VITE_POSTHOG_HOST=

# ---- Sanity — the build reads published content without a token (public dataset)

# Editor token, only for `npm run cms:import`. Local .env only, never Vercel.
SANITY_WRITE_TOKEN=
# Only if the dataset is ever made private.
SANITY_READ_TOKEN=

# Vercel Deploy Hook URL for `npm run cms:webhook`. Keep local; anyone with it can start a deploy.
VERCEL_DEPLOY_HOOK_URL=

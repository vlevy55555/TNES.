{
  "name": "tnes-exhibition",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/generate-seo.mjs",
    "verify": "node scripts/verify-site.mjs",
    "preview": "vite preview",
    "test": "tsc --ignoreConfig src/lib/shopify.ts src/lib/wall.ts --outDir .test-build --rootDir src --module esnext --target es2022 && node --test test/*.test.mjs",
    "deploy": "npm run build && git push"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "gsap": "^3.15.0",
    "posthog-js": "^1.437.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.3"
  }
}
